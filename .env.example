# Database (Postgres over TCP) — local docker network, VPS compose, or hosted.
# Docker compose example (app container → eatracker-db service):
#   postgresql://eatracker:CHANGE_ME@eatracker-db:5432/eatracker?sslmode=disable
# Host / Vercel with Neon TCP (not Neon HTTP-only pooler URLs):
#   postgresql://user:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://eatracker:CHANGE_ME@eatracker-db:5432/eatracker?sslmode=disable"

# Public Site URL (canonical / SEO primary — no 'steam' trademark in domain)
NEXT_PUBLIC_SITE_URL="https://eatracker.clear-frames.com"
NEXT_PUBLIC_SITE_NAME="EA Tracker"

# Revalidation Secret (optional; used when crawler pings /api/revalidate)
REVALIDATE_SECRET="replace-with-strong-secret-token"

# Protects /api/cron/* manual triggers. Vercel Cron also sends x-vercel-cron: 1.
# Free: set this in the Vercel project env (not required for scheduled cron invokes).
CRON_SECRET="replace-with-strong-cron-secret"

# Steam Official Web API Key (OPTIONAL — only for IStoreService/GetAppList).
# GetNumberOfCurrentPlayers and store search need no key. Flagged: do not buy paid Steam tiers.
STEAM_WEB_API_KEY=""

# Cloudflare Turnstile (Optional: protects /report form against spam)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Crawler User-Agent Contact
CRAWLER_USER_AGENT="EATrackerBot/1.0 (+https://eatracker.clear-frames.com/methodology)"
