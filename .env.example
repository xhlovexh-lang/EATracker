# Database (Neon Postgres)
DATABASE_URL="postgresql://user:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Public Site URL (No 'steam' trademark in domain)
NEXT_PUBLIC_SITE_URL="https://eatrackers.vercel.app"
NEXT_PUBLIC_SITE_NAME="EA Tracker"

# Revalidation Secret (Shared between GitHub Actions crawler & Vercel)
REVALIDATE_SECRET="replace-with-strong-secret-token"

# Steam Official Web API Key (Only needed in GitHub Actions for GetAppList/v1)
STEAM_WEB_API_KEY="replace-with-steam-web-api-key"

# Cloudflare Turnstile (Optional: protects /report form against spam)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Crawler User-Agent Contact
CRAWLER_USER_AGENT="EATrackerBot/1.0 (+https://eatrackers.vercel.app/methodology)"
